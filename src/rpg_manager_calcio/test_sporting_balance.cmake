    invoke(2 --seeds "${WORK}/bad-seeds" --fixtures 1 --selectors 1
        --matrix balanced-v1 --half-time keep --replay none --output "${WORK}/invalid")
endforeach()
string(REPEAT "0" 10000 overlong)
file(WRITE "${WORK}/bad-seeds" "${overlong}\n")
invoke(2 --seeds "${WORK}/bad-seeds" --fixtures 1 --selectors 1
    --matrix balanced-v1 --half-time keep --replay none --output "${WORK}/invalid")
invoke(2 --seeds "${WORK}/missing-seeds" --fixtures 1 --selectors 1
    --matrix balanced-v1 --half-time keep --replay none --output "${WORK}/invalid")
invoke(1 --seeds "${WORK}/seeds" --fixtures 1 --selectors 1 --matrix balanced-v1
    --half-time keep --replay none --output "${WORK}/missing-dir/out")
if(EXISTS /dev/full)
    file(REMOVE "${WORK}/full-manifest.csv")
    file(CREATE_LINK /dev/full "${WORK}/full-manifest.csv" SYMBOLIC RESULT link_result)
    if(NOT "${link_result}" STREQUAL "0")
        message(FATAL_ERROR "Cannot create output-error witness: ${link_result}")
    endif()
    invoke(1 --seeds "${WORK}/seeds" --fixtures 1 --selectors 1 --matrix balanced-v1
        --half-time keep --replay none --output "${WORK}/full")
    file(READ "${WORK}/full-summary.txt" failed_summary)
    if(NOT failed_summary MATCHES "campaign=failed")
        message(FATAL_ERROR "Buffered output failure must not leave a successful summary")
    endif()
