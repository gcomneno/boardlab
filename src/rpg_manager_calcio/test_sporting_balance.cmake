foreach(bad IN ITEMS "2,1" "1,1" "3" "01")
    invoke(2 --seeds "${WORK}/seeds" --fixtures 1 --selectors "${bad}"
        --matrix balanced-v1 --half-time keep --replay all --output "${WORK}/invalid")
endforeach()
invoke(2 --seeds "${WORK}/seeds" --fixtures 1 --selectors 1 --matrix unknown
    --half-time keep --replay none --output "${WORK}/invalid")
