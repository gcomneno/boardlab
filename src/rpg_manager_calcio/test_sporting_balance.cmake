# Use header lookup so the assertions name their source fields explicitly.
function(value header row column destination)
    string(REPLACE "," ";" names "${header}")
    string(REPLACE "," ";" values "${row}")
    list(FIND names "${column}" at)
    list(LENGTH names width)
    list(LENGTH values actual)
    if(at LESS 0 OR NOT width EQUAL actual)
        message(FATAL_ERROR "Schema/row mismatch for ${column}: ${header}\n${row}")
    endif()
    list(GET values ${at} cell)
    set(${destination} "${cell}" PARENT_SCOPE)
endfunction()

function(expect header row column expected)
    value("${header}" "${row}" "${column}" got)
    if(NOT "${got}" STREQUAL "${expected}")
        message(FATAL_ERROR "${column}: expected ${expected}, got ${got}\n${row}")
    endif()
endfunction()

foreach(fixture IN ITEMS 1 29)
    foreach(repeat IN ITEMS a b)
        invoke(0 --seeds "${WORK}/seeds" --fixtures "${fixture}" --selectors 1,2
            --matrix balanced-v1 --half-time keep --replay all --output "${WORK}/f${fixture}-${repeat}")
    endforeach()
    foreach(suffix IN ITEMS manifest.csv matches.csv team-matches.csv players.csv shot-bins.csv recovery-bins.csv summary.txt)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files
            "${WORK}/f${fixture}-a-${suffix}" "${WORK}/f${fixture}-b-${suffix}" RESULT_VARIABLE same)
        if(NOT same EQUAL 0)
            message(FATAL_ERROR "Nondeterministic ${suffix}, fixture ${fixture}")
        endif()
    endforeach()
    file(STRINGS "${WORK}/f${fixture}-a-matches.csv" matches)
    list(LENGTH matches count)
    if(NOT count EQUAL 3)
        message(FATAL_ERROR "Expected two complete selector executions")
    endif()
    list(GET matches 0 header)
    math(EXPR fixture_index "${fixture} - 1")
    foreach(selector IN ITEMS 1 2)
        list(GET matches ${selector} row)
        expect("${header}" "${row}" world_ordinal 0)
        expect("${header}" "${row}" world_seed 20261114)
        expect("${header}" "${row}" match_id "${fixture}")
        expect("${header}" "${row}" fixture_index "${fixture_index}")
        expect("${header}" "${row}" selector_version "${selector}")
        expect("${header}" "${row}" scenario_k 0)
        expect("${header}" "${row}" home_formation 442)
        expect("${header}" "${row}" away_formation 442)
        expect("${header}" "${row}" home_tactics 0)
        expect("${header}" "${row}" away_tactics 0)
        expect("${header}" "${row}" opener_team_id 4)
        expect("${header}" "${row}" status complete)
        expect("${header}" "${row}" stage complete)
        expect("${header}" "${row}" error_code 0)
        expect("${header}" "${row}" replay pass)
        expect("${header}" "${row}" terminal_reason 1)
        expect("${header}" "${row}" elapsed_seconds 5400)
        if(fixture EQUAL 1)
            expect("${header}" "${row}" home_team_id 4)
            expect("${header}" "${row}" away_team_id 6)
            expect("${header}" "${row}" leg 0)
        else()
            expect("${header}" "${row}" home_team_id 6)
            expect("${header}" "${row}" away_team_id 4)
            expect("${header}" "${row}" leg 1)
        endif()
        foreach(column IN ITEMS home_goals away_goals goal_events shot_events chance_events
                accepted_commands sporting_commands events pass_attempts pass_completed pass_failed
                tackle_attempts tackle_retained tackle_won tackle_loose recoveries)
            value("${header}" "${row}" "${column}" "n_${column}")
        endforeach()
        math(EXPR goals "${n_home_goals} + ${n_away_goals}")
        if(NOT goals EQUAL n_goal_events OR NOT n_shot_events EQUAL n_chance_events)
            message(FATAL_ERROR "Goal/shot reconciliation failure")
        endif()
        value("${header}" "${row}" cmd_11 shot_commands)
        value("${header}" "${row}" evt_9 shot_events)
        value("${header}" "${row}" evt_10 goal_events)
        if(NOT shot_commands EQUAL n_shot_events OR NOT shot_events EQUAL n_shot_events OR NOT goal_events EQUAL goals)
            message(FATAL_ERROR "ACTION/SHOT/GOAL double counting")
        endif()
        math(EXPR passes "${n_pass_completed} + ${n_pass_failed}")
        math(EXPR tackles "${n_tackle_retained} + ${n_tackle_won} + ${n_tackle_loose}")
        if(NOT passes EQUAL n_pass_attempts OR NOT tackles EQUAL n_tackle_attempts)
            message(FATAL_ERROR "Pass/tackle outcome distinction")
        endif()
        set(cmd_sum 0)
        set(sport_sum 0)
        foreach(i RANGE 0 11)
            value("${header}" "${row}" "cmd_${i}" n)
            math(EXPR cmd_sum "${cmd_sum} + ${n}")
            if(i GREATER_EQUAL 5)
                math(EXPR sport_sum "${sport_sum} + ${n}")
            endif()
        endforeach()
        set(evt_sum 0)
        foreach(i RANGE 0 14)
            value("${header}" "${row}" "evt_${i}" n)
            math(EXPR evt_sum "${evt_sum} + ${n}")
        endforeach()
        if(NOT cmd_sum EQUAL n_accepted_commands OR NOT sport_sum EQUAL n_sporting_commands OR NOT evt_sum EQUAL n_events)
            message(FATAL_ERROR "Command/event totals")
        endif()
        value("${header}" "${row}" cmd_5 recovery_commands)
        value("${header}" "${row}" evt_2 action_events)
        math(EXPR actions "${n_sporting_commands} - ${recovery_commands}")
        if(NOT action_events EQUAL actions)
            message(FATAL_ERROR "Controlled/timed action double count")
        endif()
    endforeach()
    file(STRINGS "${WORK}/f${fixture}-a-team-matches.csv" teams)
    file(STRINGS "${WORK}/f${fixture}-a-players.csv" players)
    list(LENGTH teams team_count)
    list(LENGTH players player_count)
    if(NOT team_count EQUAL 5 OR NOT player_count EQUAL 45)
        message(FATAL_ERROR "Must preserve all eleven players for every team")
    endif()
    list(GET teams 0 team_header)
    list(GET players 0 player_header)
    foreach(team_row RANGE 1 4)
        list(GET teams ${team_row} t)
        value("${team_header}" "${t}" selector_version selector)
        value("${team_header}" "${t}" side side)
        expect("${team_header}" "${t}" participants_den 11)
        set(participants 0)
        set(receipts 0)
        set(controlled 0)
        set(goals 0)
        set(shots 0)
        foreach(d RANGE 0 3)
            set(d_receipts_${d} 0)
            set(d_controlled_${d} 0)
            set(d_goals_${d} 0)
        endforeach()
        foreach(slot RANGE 0 10)
            math(EXPR player_row "(${selector} - 1) * 22 + ${side} * 11 + ${slot} + 1")
            list(GET players ${player_row} p)
            expect("${player_header}" "${p}" lineup_index "${slot}")
            expect("${player_header}" "${p}" selector_version "${selector}")
            expect("${player_header}" "${p}" side "${side}")
            value("${player_header}" "${p}" department d)
            value("${player_header}" "${p}" participations n)
            if(n GREATER 0)
                math(EXPR participants "${participants} + 1")
            endif()
            foreach(pair IN ITEMS "receipts:pass_receptions" "controlled:controlled_actions" "goals:goals" "shots:shots")
                string(REPLACE ":" ";" pair "${pair}")
                list(GET pair 0 accumulator)
                list(GET pair 1 column)
                value("${player_header}" "${p}" "${column}" n)
                math(EXPR ${accumulator} "${${accumulator}} + ${n}")
                if(NOT accumulator STREQUAL "shots")
                    math(EXPR d_${accumulator}_${d} "${d_${accumulator}_${d}} + ${n}")
                endif()
            endforeach()
        endforeach()
        math(EXPR zero "11 - ${participants}")
        expect("${team_header}" "${t}" participants_num "${participants}")
        expect("${team_header}" "${t}" zero_players "${zero}")
        expect("${team_header}" "${t}" pass_completed "${receipts}")
        expect("${team_header}" "${t}" controlled_actions "${controlled}")
        expect("${team_header}" "${t}" goals "${goals}")
        expect("${team_header}" "${t}" shots "${shots}")
        set(d 0)
        foreach(department IN ITEMS gk def mid att)
            foreach(metric IN ITEMS receipts controlled goals)
                expect("${team_header}" "${t}" "${metric}_${department}" "${d_${metric}_${d}}")
            endforeach()
            math(EXPR d "${d} + 1")
        endforeach()
    endforeach()
    file(READ "${WORK}/f${fixture}-a-summary.txt" summary)
    if(NOT summary MATCHES "campaign=complete\nattempted=2\ncompleted=2\nincomplete=0" OR
       NOT summary MATCHES "paired_complete=1" OR NOT summary MATCHES "replay_verified=1")
        message(FATAL_ERROR "Summary completion/replay/paired accounting")
    endif()
endforeach()
message(STATUS "Two genuine fixtures x both selectors, repeated byte-identical CSV and summary; strict CLI/manifest/I/O errors PASS")
