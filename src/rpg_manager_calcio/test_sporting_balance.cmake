function(invoke expected)
    execute_process(COMMAND "${LAB}" ${ARGN} RESULT_VARIABLE result
        OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 15)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected ${expected}, got ${result}: ${ARGN}\n${out}\n${err}")
    endif()
endfunction()

execute_process(COMMAND "${CHECK}" RESULT_VARIABLE check_result
    OUTPUT_VARIABLE check_out ERROR_VARIABLE check_err TIMEOUT 30)
if(NOT "${check_result}" STREQUAL "0" OR NOT check_out MATCHES "Balance self-check PASS")
    message(FATAL_ERROR "Reducer/production/replay self-check: ${check_result}\n${check_out}\n${check_err}")
endif()
message(STATUS "${check_out}")
invoke(0 --help)
invoke(2)
invoke(2 --help --help)
invoke(2 ${common} --unknown value)
invoke(2 ${common} --selectors 1)
invoke(2 ${common} --seeds)
invoke(2 --seeds "${WORK}/seeds")
foreach(option IN ITEMS --seeds --fixtures --selectors --matrix --half-time --replay --output)
    invoke(2 ${common} ${option} value)
endforeach()
