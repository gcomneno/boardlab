{
  "name": "dado-goal-multiplayer-beta",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dado-goal-multiplayer",
      "database_id": "00000000-0000-4000-8000-000000000004",
      "migrations_dir": "migrations"
    }
  ]
}
